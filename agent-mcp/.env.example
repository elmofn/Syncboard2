# URL pública do SyncBOARD (sem barra no final)
SYNCBOARD_BASE_URL=https://syncboard.travelcash.me

# Chave do agente, gerada por POST /api/admin/agent-keys (admin logado)
AGENT_API_KEY=sb_agent_xxxxxxxxxxxxxxxxxxxx

# Token que o ChatGPT envia a ESTE servidor (hop ChatGPT→MCP). Gere com:
#   openssl rand -base64 32
# Configure o mesmo valor na autenticação do conector no ChatGPT.
MCP_AUTH_TOKEN=troque-por-um-token-forte

# Porta HTTP (Azure Container Apps injeta; padrão 8080)
PORT=8080
