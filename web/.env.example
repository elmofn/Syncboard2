# Modo de execução do frontend.
#   (ausente/qualquer coisa) = mock  -> login e quadro funcionam SEM OAuth/APIs (dados em memória)
#   live                      = live -> usa /.auth/me (Google OAuth) e /api/* reais via SWA
# Para desenvolvimento com backend real: VITE_MODE=live e rode o SWA CLI (swa start) na porta 4280.
VITE_MODE=mock
